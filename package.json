{
  "name": "assetmapping-backend",
  "version": "1.0.0",
  "description": "Backend service for Asset Mapping application with sync, validation, and image processing",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node scripts/migration-helper.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:system": "bash scripts/run-tests.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pins": "jest tests/system/pins",
    "test:forms": "jest tests/system/forms",
    "test:batch": "jest tests/system/batch",
    "test:idempotency": "jest tests/system/idempotency",
    "test:conflicts": "jest tests/system/conflicts",
    "test:workflows": "jest tests/system/workflows"
  },
  "keywords": [
    "asset-mapping",
    "express",
    "typescript",
    "redis",
    "kafka"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.7",
    "redis": "^4.6.11",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.25",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "axios": "^1.13.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
