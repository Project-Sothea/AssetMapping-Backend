# Server Configuration
PORT=3000
NODE_ENV=development

#Local Docker PostgreSQL
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/assetmapping

# Supabase Configuration (use service role key for backend)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=assetmapping-backend
KAFKA_GROUP_ID=assetmapping-consumer-group

# Image Processing
MAX_IMAGE_SIZE_MB=10
IMAGE_QUALITY=80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:8081,exp://192.168.1.1:19000
